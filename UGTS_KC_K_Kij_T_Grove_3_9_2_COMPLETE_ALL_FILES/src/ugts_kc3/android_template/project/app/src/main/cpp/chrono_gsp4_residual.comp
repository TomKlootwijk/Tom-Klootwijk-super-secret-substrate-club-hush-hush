#version 460
#extension GL_EXT_shader_8bit_storage : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer CurrentDense {
    uint8_t current_bytes[];
};
layout(set = 0, binding = 1, std430) readonly buffer PreviousDense {
    uint8_t previous_bytes[];
};
layout(set = 0, binding = 2, std430) readonly buffer LaneSourceMap {
    uint source_index[];
};
layout(set = 0, binding = 3, std430) writeonly buffer CanonicalResidual {
    uint8_t residual_bytes[];
};

layout(push_constant) uniform ResidualParameters {
    uint logical_lane_count;
} parameters;

void main() {
    const uint lane = gl_GlobalInvocationID.x;
    if (lane >= parameters.logical_lane_count) return;
    const uint source = source_index[lane];
    residual_bytes[lane] = uint8_t(
        uint(current_bytes[source]) - uint(previous_bytes[source])
    );
}
