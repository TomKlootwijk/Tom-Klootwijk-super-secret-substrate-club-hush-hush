build libugts_kc_native.so: CXX_SHARED_LIBRARY_LINKER__ugts_kc_native_ CMakeFiles/ugts_kc_native.dir/main.cpp.o CMakeFiles/ugts_kc_native.dir/engine.cpp.o CMakeFiles/ugts_kc_native.dir/body_physics.cpp.o CMakeFiles/ugts_kc_native.dir/touch_router.cpp.o CMakeFiles/ugts_kc_native.dir/trigger_area.cpp.o CMakeFiles/ugts_kc_native.dir/graph_vm.cpp.o CMakeFiles/ugts_kc_native.dir/polar_kinematics.cpp.o CMakeFiles/ugts_kc_native.dir/transform_animation.cpp.o CMakeFiles/ugts_kc_native.dir/renderer_gles3.cpp.o CMakeFiles/ugts_kc_native.dir/scene_pack.cpp.o CMakeFiles/ugts_kc_native.dir/device_profile.cpp.o CMakeFiles/ugts_kc_native.dir/adaptive_quality.cpp.o CMakeFiles/ugts_kc_native.dir/grove_juice.cpp.o CMakeFiles/ugts_kc_native.dir/grove_tuning.cpp.o CMakeFiles/ugts_kc_native.dir/scatter_population.cpp.o | libnative_app_glue.a || libnative_app_glue.a
