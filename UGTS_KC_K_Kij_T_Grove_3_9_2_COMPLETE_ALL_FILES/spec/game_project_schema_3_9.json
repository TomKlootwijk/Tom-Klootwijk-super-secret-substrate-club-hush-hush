{
  "$defs": {
    "entity": {
      "additionalProperties": true,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "components": {
          "additionalProperties": {
            "type": "object"
          },
          "minProperties": 1,
          "type": "object"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "components"
      ],
      "type": "object"
    }
  },
  "$id": "urn:ugts-kc:game-project:3.9",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "ugts-kc-game-project-3.9"
    },
    "audio": {
      "additionalProperties": true,
      "required": [
        "cues",
        "sequences"
      ],
      "type": "object"
    },
    "build": {
      "type": "object"
    },
    "display": {
      "additionalProperties": true,
      "properties": {
        "antialias": {
          "type": "boolean"
        },
        "background": {
          "minLength": 1,
          "type": "string"
        },
        "fullscreen": {
          "type": "boolean"
        },
        "height": {
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait",
            "any"
          ]
        },
        "pixel_ratio": {
          "enum": [
            "device",
            "1",
            "2"
          ]
        },
        "scaling": {
          "enum": [
            "fit",
            "fill",
            "stretch",
            "integer"
          ]
        },
        "width": {
          "maximum": 16384,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "background",
        "scaling"
      ],
      "type": "object"
    },
    "input": {
      "additionalProperties": true,
      "properties": {
        "actions": {
          "type": "array"
        }
      },
      "required": [
        "actions"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "properties": {
        "author": {
          "type": "string"
        },
        "codename": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "runtime_version": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "runtime_version",
        "codename"
      ],
      "type": "object"
    },
    "scenes": {
      "additionalProperties": {
        "additionalProperties": true,
        "properties": {
          "background": {
            "type": [
              "string",
              "null"
            ]
          },
          "entities": {
            "items": {
              "$ref": "#/$defs/entity"
            },
            "type": "array"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "initial_state": {
            "type": "object"
          },
          "rules": {
            "type": "object"
          },
          "tilemaps": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ui": {
            "type": "array"
          },
          "world_size": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "exclusiveMinimum": 0,
                "type": "number"
              }
            ],
            "type": "array"
          }
        },
        "required": [
          "id",
          "world_size",
          "entities"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "start_scene": {
      "minLength": 1,
      "type": "string"
    },
    "tilemaps": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    },
    "vector_assets": {
      "additionalProperties": {
        "type": "object"
      },
      "type": "object"
    }
  },
  "required": [
    "$schema",
    "metadata",
    "display",
    "input",
    "vector_assets",
    "audio",
    "tilemaps",
    "scenes",
    "start_scene",
    "build"
  ],
  "title": "UGTS-KC 3.9 KC Elizabeth Game Project",
  "type": "object"
}
