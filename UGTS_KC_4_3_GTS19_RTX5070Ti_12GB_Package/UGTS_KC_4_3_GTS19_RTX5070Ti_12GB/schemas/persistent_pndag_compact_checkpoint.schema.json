{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ugts:go:persistent-pndag-compact-checkpoint:v1",
  "title": "UGTS bounded exact compact persistent-history PNDAG checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codec",
    "compact_artifact_sha256",
    "format",
    "history_forest",
    "legacy_envelope",
    "nodes"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "boardHex": {
      "type": "string",
      "pattern": "^(?:0[0-2]|(?:0[0-2]){4})$"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collision_checked", "name"],
      "properties": {
        "collision_checked": {"const": true},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_suicide",
        "komi2",
        "passes_to_end",
        "profile_id",
        "scoring",
        "size",
        "superko"
      ],
      "properties": {
        "allow_suicide": {"type": "boolean"},
        "komi2": {"$ref": "#/$defs/int64"},
        "passes_to_end": {"const": 2},
        "profile_id": {"type": "string", "minLength": 1},
        "scoring": {"const": "area"},
        "size": {"enum": [1, 2]},
        "superko": {"const": "positional_superko"}
      }
    },
    "proofArithmetic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bits", "endianness", "infinity", "kind"],
      "properties": {
        "bits": {"const": 64},
        "endianness": {"const": "little"},
        "infinity": {"const": "18446744073709551615"},
        "kind": {"const": "saturating_uint64"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_id", "move"],
      "properties": {
        "child_id": {"$ref": "#/$defs/uint64"},
        "move": {"type": "integer", "minimum": -1, "maximum": 3}
      }
    },
    "compactNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "board_hex",
        "cached_disproof",
        "cached_proof",
        "children",
        "digest",
        "expansion",
        "id",
        "passes",
        "previous_board_hex",
        "rank",
        "to_play"
      ],
      "properties": {
        "board_hex": {"$ref": "#/$defs/boardHex"},
        "cached_disproof": {"$ref": "#/$defs/uint64"},
        "cached_proof": {"$ref": "#/$defs/uint64"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        },
        "digest": {"$ref": "#/$defs/sha256"},
        "expansion": {"enum": ["unexpanded", "expanded", "terminal"]},
        "id": {"$ref": "#/$defs/uint64"},
        "passes": {"type": "integer", "minimum": 0, "maximum": 2},
        "previous_board_hex": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/boardHex"}
          ]
        },
        "rank": {
          "allOf": [
            {"$ref": "#/$defs/uint64"},
            {"minimum": 2}
          ]
        },
        "to_play": {"enum": [1, 2]}
      }
    },
    "forestBoard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "id", "index_digest", "raw_hex"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "id": {"$ref": "#/$defs/nonnegativeInteger"},
        "index_digest": {"$ref": "#/$defs/sha256"},
        "raw_hex": {"$ref": "#/$defs/boardHex"}
      }
    },
    "forestLeafBoardReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_id", "content_sha256", "raw_hex"],
      "properties": {
        "board_id": {"$ref": "#/$defs/nonnegativeInteger"},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "raw_hex": {"$ref": "#/$defs/boardHex"}
      }
    },
    "forestChildReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_id", "child_sha256", "slot"],
      "properties": {
        "child_id": {"$ref": "#/$defs/nonnegativeInteger"},
        "child_sha256": {"$ref": "#/$defs/sha256"},
        "slot": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "forestLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boards",
        "content_sha256",
        "count",
        "depth",
        "id",
        "index_digest",
        "kind"
      ],
      "properties": {
        "boards": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/forestLeafBoardReference"}
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "count": {"$ref": "#/$defs/positiveInteger"},
        "depth": {"const": 32},
        "id": {"$ref": "#/$defs/nonnegativeInteger"},
        "index_digest": {"$ref": "#/$defs/sha256"},
        "kind": {"const": "leaf"}
      }
    },
    "forestBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "children",
        "content_sha256",
        "count",
        "depth",
        "id",
        "kind"
      ],
      "properties": {
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/$defs/forestChildReference"}
        },
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "count": {"$ref": "#/$defs/positiveInteger"},
        "depth": {"type": "integer", "minimum": 0, "maximum": 31},
        "id": {"$ref": "#/$defs/nonnegativeInteger"},
        "kind": {"const": "branch"}
      }
    },
    "forestNode": {
      "oneOf": [
        {"$ref": "#/$defs/forestLeaf"},
        {"$ref": "#/$defs/forestBranch"}
      ]
    },
    "forestRootReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256", "node_id"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "node_id": {"$ref": "#/$defs/nonnegativeInteger"}
      }
    },
    "forestRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_count", "node_ref", "root_sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/nonnegativeInteger"},
        "member_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "node_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/forestRootReference"}
          ]
        },
        "root_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "historyForest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_sha256",
        "board_bytes",
        "board_record_count",
        "board_size",
        "boards",
        "digest_index",
        "format",
        "node_record_count",
        "nodes",
        "root_count",
        "roots"
      ],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "board_bytes": {"enum": [1, 4]},
        "board_record_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "board_size": {"enum": [1, 2]},
        "boards": {
          "type": "array",
          "items": {"$ref": "#/$defs/forestBoard"}
        },
        "digest_index": {"$ref": "#/$defs/index"},
        "format": {"const": "UGTS-PY-PERSISTENT-PSK-FOREST-v1"},
        "node_record_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/forestNode"}
        },
        "root_count": {"$ref": "#/$defs/nonnegativeInteger"},
        "roots": {
          "type": "array",
          "items": {"$ref": "#/$defs/forestRoot"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"board_size": {"const": 1}},
            "required": ["board_size"]
          },
          "then": {
            "properties": {"board_bytes": {"const": 1}}
          }
        },
        {
          "if": {
            "properties": {"board_size": {"const": 2}},
            "required": ["board_size"]
          },
          "then": {
            "properties": {"board_bytes": {"const": 4}}
          }
        }
      ]
    },
    "legacyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "committed_expansions",
        "digest_index",
        "edge_count",
        "format",
        "graph_sha256",
        "history_digest_index",
        "history_format",
        "move_order",
        "node_count",
        "proof_arithmetic",
        "root_disproof_number",
        "root_id",
        "root_proof_number",
        "root_state_object_id",
        "rules",
        "rules_sha256",
        "scope",
        "selection",
        "state_format",
        "status",
        "symmetry",
        "threshold2"
      ],
      "properties": {
        "algorithm": {"const": "bounded-exact-persistent-pndag-v2"},
        "committed_expansions": {"$ref": "#/$defs/uint64"},
        "digest_index": {"$ref": "#/$defs/index"},
        "edge_count": {"$ref": "#/$defs/uint64"},
        "format": {"const": "UGTS-GO-PERSISTENT-PNDAG-CHECKPOINT-v2"},
        "graph_sha256": {"$ref": "#/$defs/sha256"},
        "history_digest_index": {"$ref": "#/$defs/index"},
        "history_format": {"const": "UGTS-PY-PERSISTENT-PSK-v1"},
        "move_order": {"const": "numeric-pass-minus-one-semantic-state-v2"},
        "node_count": {
          "allOf": [
            {"$ref": "#/$defs/uint64"},
            {"minimum": 1}
          ]
        },
        "proof_arithmetic": {"$ref": "#/$defs/proofArithmetic"},
        "root_disproof_number": {"$ref": "#/$defs/uint64"},
        "root_id": {"const": 0},
        "root_proof_number": {"$ref": "#/$defs/uint64"},
        "root_state_object_id": {"$ref": "#/$defs/sha256"},
        "rules": {"$ref": "#/$defs/rules"},
        "rules_sha256": {"$ref": "#/$defs/sha256"},
        "scope": {"const": "bounded-host-ram-persistent-pndag-psk-1x1-2x2"},
        "selection": {"const": "unresolved-pns-pn-dn-move-semantic-state-v2"},
        "state_format": {"const": "UGTS-GO-PERSISTENT-STATE-v2"},
        "status": {"enum": ["PROVEN", "DISPROVEN", "UNKNOWN"]},
        "symmetry": {"const": "none"},
        "threshold2": {"$ref": "#/$defs/int64"}
      }
    }
  },
  "properties": {
    "codec": {"const": "exact-history-forest-to-strict-legacy-loader-v1"},
    "compact_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "format": {"const": "UGTS-GO-PERSISTENT-PNDAG-COMPACT-CHECKPOINT-v1"},
    "history_forest": {"$ref": "#/$defs/historyForest"},
    "legacy_envelope": {"$ref": "#/$defs/legacyEnvelope"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/compactNode"}
    }
  }
}
