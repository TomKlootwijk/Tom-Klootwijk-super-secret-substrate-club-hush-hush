{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ugts-chess-wdl-fact-v2.schema.json",
  "title": "UGTS Chess verified WDL fact journal v2",
  "description": "Strict structural schema for canonical v2 seed/derivation fact payloads and externally retained fact-journal heads. Runtime replay remains authoritative for canonical ordering, hashes, exact chess transitions, backward references, proof-height equality, and WDL aggregation.",
  "oneOf": [
    {"$ref": "#/$defs/fact_record"},
    {"$ref": "#/$defs/fact_journal_head"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "not": {"type": "boolean"}
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "not": {"type": "boolean"}
    },
    "proof_height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "not": {"type": "boolean"}
    },
    "exact_wdl": {
      "enum": ["win", "loss", "draw"]
    },
    "history_entry": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/sha256"},
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "not": {"type": "boolean"}
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "history_counts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/history_entry"}
    },
    "seed_verifier_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "root_value",
        "root_exact",
        "verified_reachable_nodes",
        "exact_nodes",
        "unknown_nodes",
        "unreferenced_nodes",
        "root_certificate_hash"
      ],
      "properties": {
        "valid": {"const": true},
        "root_value": {"$ref": "#/$defs/exact_wdl"},
        "root_exact": {"const": true},
        "verified_reachable_nodes": {"$ref": "#/$defs/positive_integer"},
        "exact_nodes": {"$ref": "#/$defs/positive_integer"},
        "unknown_nodes": {"const": 0},
        "unreferenced_nodes": {"const": 0},
        "root_certificate_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "seed_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "certificate_encoding",
        "certificate_size",
        "certificate_sha256",
        "certificate_base64",
        "root_certificate_hash",
        "verifier_profile",
        "verifier_result"
      ],
      "properties": {
        "schema": {"const": "ugts-chess-wdl-seed-evidence-1.0"},
        "certificate_encoding": {"const": "canonical-json-utf8"},
        "certificate_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912,
          "not": {"type": "boolean"}
        },
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_base64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64"
        },
        "root_certificate_hash": {"$ref": "#/$defs/sha256"},
        "verifier_profile": {
          "const": "ugts-chess-wdl-bundle-seed-verifier-1.0"
        },
        "verifier_result": {"$ref": "#/$defs/seed_verifier_result"}
      }
    },
    "move_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uci",
        "dag_edge_record_index",
        "dag_edge_content_sha256",
        "child_node_sha256",
        "fact_record_index",
        "fact_content_sha256",
        "child_wdl",
        "child_proof_height"
      ],
      "properties": {
        "uci": {
          "type": "string",
          "pattern": "^[a-h][1-8][a-h][1-8][qrbn]?$"
        },
        "dag_edge_record_index": {"$ref": "#/$defs/nonnegative_integer"},
        "dag_edge_content_sha256": {"$ref": "#/$defs/sha256"},
        "child_node_sha256": {"$ref": "#/$defs/sha256"},
        "fact_record_index": {"$ref": "#/$defs/nonnegative_integer"},
        "fact_content_sha256": {"$ref": "#/$defs/sha256"},
        "child_wdl": {"$ref": "#/$defs/exact_wdl"},
        "child_proof_height": {"$ref": "#/$defs/proof_height"}
      }
    },
    "derivation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "root_value",
        "proof_height",
        "derivation_code",
        "move_dependencies"
      ],
      "properties": {
        "schema": {"const": "ugts-chess-wdl-derivation-evidence-1.0"},
        "root_value": {"$ref": "#/$defs/exact_wdl"},
        "proof_height": {"$ref": "#/$defs/proof_height"},
        "derivation_code": {
          "enum": [
            "checkmate",
            "stalemate",
            "dead_position",
            "seventy_five_move",
            "fivefold_repetition",
            "winning_move_witness",
            "all_legal_moves_lose",
            "draw_action_and_no_winning_move"
          ]
        },
        "move_dependencies": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/move_dependency"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"derivation_code": {"const": "checkmate"}},
            "required": ["derivation_code"]
          },
          "then": {
            "properties": {
              "root_value": {"const": "loss"},
              "proof_height": {"const": 0},
              "move_dependencies": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "derivation_code": {
                "enum": [
                  "stalemate",
                  "dead_position",
                  "seventy_five_move",
                  "fivefold_repetition"
                ]
              }
            },
            "required": ["derivation_code"]
          },
          "then": {
            "properties": {
              "root_value": {"const": "draw"},
              "proof_height": {"const": 0},
              "move_dependencies": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "derivation_code": {"const": "winning_move_witness"}
            },
            "required": ["derivation_code"]
          },
          "then": {
            "properties": {
              "root_value": {"const": "win"},
              "proof_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "not": {"type": "boolean"}
              },
              "move_dependencies": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "properties": {"child_wdl": {"const": "loss"}},
                  "required": ["child_wdl"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "derivation_code": {"const": "all_legal_moves_lose"}
            },
            "required": ["derivation_code"]
          },
          "then": {
            "properties": {
              "root_value": {"const": "loss"},
              "proof_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "not": {"type": "boolean"}
              },
              "move_dependencies": {
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {"child_wdl": {"const": "win"}},
                  "required": ["child_wdl"]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "derivation_code": {
                "const": "draw_action_and_no_winning_move"
              }
            },
            "required": ["derivation_code"]
          },
          "then": {
            "properties": {
              "root_value": {"const": "draw"},
              "proof_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "not": {"type": "boolean"}
              },
              "move_dependencies": {
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "child_wdl": {"enum": ["win", "draw"]}
                  },
                  "required": ["child_wdl"]
                }
              }
            }
          }
        }
      ]
    },
    "fact_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "record_index",
        "previous_fact_sha256",
        "kind",
        "node_sha256",
        "first_frontier_content_sha256",
        "rule_profile_id",
        "fen",
        "history_counts",
        "position_sha256",
        "game_state_sha256",
        "claimed_wdl",
        "proof_height",
        "evidence_sha256",
        "evidence"
      ],
      "properties": {
        "schema": {"const": "ugts-chess-verified-wdl-fact-2.0"},
        "record_index": {"$ref": "#/$defs/nonnegative_integer"},
        "previous_fact_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "kind": {"enum": ["seed", "derivation"]},
        "node_sha256": {"$ref": "#/$defs/sha256"},
        "first_frontier_content_sha256": {"$ref": "#/$defs/sha256"},
        "rule_profile_id": {
          "const": "fide-classical-2023-claims-as-actions-v2"
        },
        "fen": {"type": "string", "minLength": 1},
        "history_counts": {"$ref": "#/$defs/history_counts"},
        "position_sha256": {"$ref": "#/$defs/sha256"},
        "game_state_sha256": {"$ref": "#/$defs/sha256"},
        "claimed_wdl": {"$ref": "#/$defs/exact_wdl"},
        "proof_height": {"$ref": "#/$defs/proof_height"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "object"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"record_index": {"const": 0}},
            "required": ["record_index"]
          },
          "then": {
            "properties": {"previous_fact_sha256": {"type": "null"}}
          },
          "else": {
            "properties": {
              "previous_fact_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "seed"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {"evidence": {"$ref": "#/$defs/seed_evidence"}}
          },
          "else": {
            "properties": {
              "evidence": {"$ref": "#/$defs/derivation_evidence"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "seed"},
              "claimed_wdl": {"const": "win"}
            },
            "required": ["kind", "claimed_wdl"]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "verifier_result": {
                    "properties": {"root_value": {"const": "win"}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "seed"},
              "claimed_wdl": {"const": "loss"}
            },
            "required": ["kind", "claimed_wdl"]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "verifier_result": {
                    "properties": {"root_value": {"const": "loss"}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "seed"},
              "claimed_wdl": {"const": "draw"}
            },
            "required": ["kind", "claimed_wdl"]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "verifier_result": {
                    "properties": {"root_value": {"const": "draw"}}
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "derivation"},
              "evidence": {
                "properties": {"derivation_code": {"const": "checkmate"}},
                "required": ["derivation_code"]
              }
            },
            "required": ["kind", "evidence"]
          },
          "then": {
            "properties": {
              "claimed_wdl": {"const": "loss"},
              "proof_height": {"const": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "derivation"},
              "evidence": {
                "properties": {
                  "derivation_code": {
                    "enum": [
                      "stalemate",
                      "dead_position",
                      "seventy_five_move",
                      "fivefold_repetition"
                    ]
                  }
                },
                "required": ["derivation_code"]
              }
            },
            "required": ["kind", "evidence"]
          },
          "then": {
            "properties": {
              "claimed_wdl": {"const": "draw"},
              "proof_height": {"const": 0}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "derivation"},
              "evidence": {
                "properties": {
                  "derivation_code": {"const": "winning_move_witness"}
                },
                "required": ["derivation_code"]
              }
            },
            "required": ["kind", "evidence"]
          },
          "then": {
            "properties": {
              "claimed_wdl": {"const": "win"},
              "proof_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "not": {"type": "boolean"}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "derivation"},
              "evidence": {
                "properties": {
                  "derivation_code": {"const": "all_legal_moves_lose"}
                },
                "required": ["derivation_code"]
              }
            },
            "required": ["kind", "evidence"]
          },
          "then": {
            "properties": {
              "claimed_wdl": {"const": "loss"},
              "proof_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "not": {"type": "boolean"}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "derivation"},
              "evidence": {
                "properties": {
                  "derivation_code": {
                    "const": "draw_action_and_no_winning_move"
                  }
                },
                "required": ["derivation_code"]
              }
            },
            "required": ["kind", "evidence"]
          },
          "then": {
            "properties": {
              "claimed_wdl": {"const": "draw"},
              "proof_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647,
                "not": {"type": "boolean"}
              }
            }
          }
        }
      ]
    },
    "fact_journal_head": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rule_profile_id",
        "record_count",
        "head_content_sha256",
        "file_size"
      ],
      "properties": {
        "schema": {"const": "ugts-chess-wdl-fact-journal-head-2.0"},
        "rule_profile_id": {
          "const": "fide-classical-2023-claims-as-actions-v2"
        },
        "record_count": {"$ref": "#/$defs/nonnegative_integer"},
        "head_content_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "file_size": {"$ref": "#/$defs/nonnegative_integer"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"record_count": {"const": 0}},
            "required": ["record_count"]
          },
          "then": {
            "properties": {"head_content_sha256": {"type": "null"}}
          },
          "else": {
            "properties": {
              "head_content_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    }
  }
}
