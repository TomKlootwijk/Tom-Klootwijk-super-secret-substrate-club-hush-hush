{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ugts-chess-proof-obligation-2.0.schema.json",
  "title": "UGTS Chess root proof obligation 2.0",
  "type": "object",
  "required": [
    "schema", "obligation_id", "parent", "action", "child", "wdl",
    "verification", "target", "proof_rule"
  ],
  "properties": {
    "schema": {"const": "ugts-chess-proof-obligation-2.0"},
    "obligation_id": {"type": "string", "pattern": "^root-(?:0[1-9]|[1-9][0-9]+)-[a-h][1-8][a-h][1-8][nbrq]?$"},
    "parent": {"$ref": "#/$defs/state"},
    "action": {
      "type": "object",
      "required": ["kind", "uci", "san"],
      "properties": {
        "kind": {"const": "move"},
        "uci": {"type": "string", "pattern": "^[a-h][1-8][a-h][1-8][nbrq]?$"},
        "san": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "child": {
      "allOf": [
        {"$ref": "#/$defs/state"},
        {
          "type": "object",
          "required": ["side_to_move"],
          "properties": {"side_to_move": {"enum": ["white", "black"]}}
        }
      ]
    },
    "wdl": {"enum": ["win", "draw", "loss", "unknown"]},
    "verification": {"type": "string", "minLength": 1},
    "target": {"const": "exact-full-game-WDL-under-declared-FIDE-profile"},
    "proof_rule": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "history": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"$ref": "#/$defs/hash"},
          {"type": "integer", "minimum": 1, "maximum": 5}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "state": {
      "type": "object",
      "required": ["fen", "position_sha256", "game_state_sha256", "history_counts"],
      "properties": {
        "fen": {"type": "string", "minLength": 1},
        "position_sha256": {"$ref": "#/$defs/hash"},
        "game_state_sha256": {"$ref": "#/$defs/hash"},
        "history_counts": {"$ref": "#/$defs/history"},
        "side_to_move": {"enum": ["white", "black"]}
      },
      "additionalProperties": false
    }
  }
}
