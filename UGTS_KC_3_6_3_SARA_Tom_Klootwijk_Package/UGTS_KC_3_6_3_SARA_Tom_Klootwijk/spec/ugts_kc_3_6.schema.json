{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ugts-kc:3.6:schema",
  "title": "UGTS-KC 3.6 Literal Referential Substrate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "substrate_id",
    "metadata",
    "definitions",
    "instances",
    "pipelines"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "3.6.0"},
    "substrate_id": {"type": "string", "pattern": "^[A-Za-z0-9:._/-]+$"},
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "description", "evidence_boundary"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_boundary": {"type": "string", "minLength": 1},
        "requester_attribution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {"type": "string"},
            "identifier": {"type": "string"},
            "date_of_birth": {"type": "string"},
            "status": {"const": "requester-supplied-unverified"}
          },
          "required": ["name", "status"]
        }
      }
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/definition"}
    },
    "instances": {
      "type": "array",
      "items": {"$ref": "#/$defs/instance"}
    },
    "pipelines": {
      "type": "array",
      "items": {"$ref": "#/$defs/pipeline"}
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9:._/-]*$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "domain",
        "codomain",
        "evaluation_phase",
        "dependencies",
        "parameters",
        "provenance",
        "content_hash"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "codomain": {"type": "string", "minLength": 1},
        "evaluation_phase": {"type": "integer", "minimum": 0, "maximum": 9},
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "parameters": {"type": "object", "additionalProperties": true},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "invariants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "note"],
          "properties": {
            "class": {
              "enum": ["source-derived", "engineering-derived", "corrected", "bounded"]
            },
            "note": {"type": "string"},
            "source_refs": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition_ref", "literal"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "definition_ref": {"$ref": "#/$defs/id"},
        "literal": {"type": "object", "additionalProperties": true},
        "state": {"type": "object", "additionalProperties": true}
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string"},
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    }
  }
}
