{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ugts_kc_3_6_3_sara.schema.json",
  "title": "UGTS-KC 3.6.3 SARA substrate",
  "type": "object",
  "required": [
    "schema_version",
    "substrate_id",
    "metadata",
    "definitions",
    "instances",
    "pipelines"
  ],
  "properties": {
    "schema_version": {
      "const": "3.6.3"
    },
    "substrate_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "domain",
          "codomain",
          "evaluation_phase",
          "dependencies",
          "content_hash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "codomain": {
            "type": "string"
          },
          "evaluation_phase": {
            "type": "integer",
            "minimum": 0
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "instances": {
      "type": "array"
    },
    "pipelines": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
