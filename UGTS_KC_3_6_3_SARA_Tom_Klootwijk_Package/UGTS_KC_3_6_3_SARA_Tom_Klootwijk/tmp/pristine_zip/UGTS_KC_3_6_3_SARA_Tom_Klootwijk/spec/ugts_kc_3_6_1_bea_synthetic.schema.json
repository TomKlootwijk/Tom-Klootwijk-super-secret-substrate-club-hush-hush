{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ugts-kc:3.6.1:bea:synthetic-topology",
  "title": "UGTS-KC 3.6.1 BEA Synthetic Cell-Complex Substrate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "substrate_id", "metadata", "definitions", "instances", "pipelines"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "3.6.1"},
    "substrate_id": {"type": "string", "pattern": "^[A-Za-z0-9:._/-]+$"},
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "description", "evidence_boundary", "revision_status"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_boundary": {"type": "string", "minLength": 1},
        "revision_status": {"const": "course-corrected-superseding-edition"},
        "requester_attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "identifier", "date_of_birth", "status"],
          "properties": {
            "name": {"const": "Tom Klootwijk"},
            "identifier": {"const": "NL200678942"},
            "date_of_birth": {"const": "10-07-1990"},
            "status": {"const": "requester-supplied-unverified"}
          }
        }
      }
    },
    "definitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/definition"}},
    "instances": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/instance"}},
    "pipelines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pipeline"}},
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind"],
        "properties": {"id": {"type": "string"}, "kind": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9:._/-]*$"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "domain", "codomain", "evaluation_phase", "dependencies", "parameters", "provenance", "content_hash"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "codomain": {"type": "string", "minLength": 1},
        "evaluation_phase": {"type": "integer", "minimum": 0, "maximum": 12},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "parameters": {"type": "object", "additionalProperties": true},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "invariants": {"type": "array", "items": {"type": "string"}},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "note", "source_refs"],
          "properties": {
            "class": {"enum": ["source-derived", "profile-axiom", "engineering-derived", "bounded"]},
            "note": {"type": "string"},
            "source_refs": {"type": "array", "items": {"type": "string"}}
          }
        },
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definition_ref", "literal", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "definition_ref": {"$ref": "#/$defs/id"},
        "literal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "semantic_value", "cycle_positions"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "semantic_value": {"type": "number"},
            "cycle_positions": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
          }
        },
        "state": {
          "type": "object",
          "additionalProperties": true,
          "required": ["profile_ref"],
          "properties": {"profile_ref": {"const": "bea361:profile:synthetic-cell-complex-v2"}}
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "steps"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "description": {"type": "string"},
        "steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
