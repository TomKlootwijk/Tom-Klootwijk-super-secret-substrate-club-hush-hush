#version 310 es
precision highp float;
precision highp int;

#ifndef ENABLE_COUNTERS
#define ENABLE_COUNTERS 1
#endif

layout(local_size_x = 256) in;

// G64: 64-byte, float32 authoritative state record.
struct State64 {
    vec4 position_time;       // xyz position, w query time
    vec4 axis_radius;        // xyz support axis, w radial reach
    vec4 phase_guard;        // x cone cos, y phase, z guard epsilon, w confidence floor
    uvec4 meta;              // x sheet, y orientation, z compatibility mask, w lineage seed
};

// E32: 32-byte event output.
struct Event32 {
    uvec4 scalar_bits;        // sdf, guard, confidence, event time as float bits
    uvec4 topology_bits;      // verified, route, lineage hash, state flags
};

layout(std430, binding = 0) readonly buffer StateBuffer {
    State64 states[];
};
layout(std430, binding = 1) writeonly buffer EventBuffer {
    Event32 events[];
};
layout(std430, binding = 2) buffer CounterBuffer {
    uint counters[4];         // candidates, in-support, compatible, verified
};

uint mix32(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(states.length())) {
        return;
    }

    State64 s = states[i];
    float r = length(s.position_time.xyz);
    vec3 axis = normalize(s.axis_radius.xyz);
    float cosine_to_axis = (r > 1e-8)
        ? dot(s.position_time.xyz / r, axis)
        : 1.0;

    bool in_support =
        (r <= s.axis_radius.w) &&
        (cosine_to_axis >= s.phase_guard.x);

    // Reference query convention used by the reproducible benchmark:
    // sheet 1, orientation 0, and compatibility mask bit 2 set.
    bool compatible =
        ((s.meta.z & 4u) != 0u) &&
        (s.meta.x == 1u) &&
        ((s.meta.y & 1u) == 0u);

    // Sphere relation surface and a finite guard band around SDF = 0.
    float sdf = r - s.axis_radius.w;
    float guard = abs(sdf) - s.phase_guard.z;
    float confidence = exp2(-abs(sdf) * 32.0);
    bool crossed = guard <= 0.0;
    bool verified =
        in_support && compatible && crossed &&
        (confidence >= s.phase_guard.w);

#if ENABLE_COUNTERS
    atomicAdd(counters[0], 1u);
    if (in_support) {
        atomicAdd(counters[1], 1u);
    }
    if (in_support && compatible) {
        atomicAdd(counters[2], 1u);
    }
    if (verified) {
        atomicAdd(counters[3], 1u);
    }
#endif

    uint route = (s.meta.y ^ (verified ? 1u : 0u)) & 1u;
    uint state_flags =
        (verified ? 1u : 0u) |
        (route << 1) |
        (s.meta.x << 2) |
        (in_support ? (1u << 10) : 0u) |
        (compatible ? (1u << 11) : 0u);

    events[i].scalar_bits = uvec4(
        floatBitsToUint(sdf),
        floatBitsToUint(guard),
        floatBitsToUint(confidence),
        floatBitsToUint(s.position_time.w));
    events[i].topology_bits = uvec4(
        verified ? 1u : 0u,
        route,
        mix32(s.meta.w ^ i),
        state_flags);
}
